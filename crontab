# 会議議事録の自動化 / crontab
#
#   crontab crontab        で登録、crontab -l で確認
#
# /path/to/meeting-automation は実際の配置に置き換えること。
#
# 時刻はサーバのローカルタイムゾーンで解釈される。JST以外のサーバに置く場合は
# CRON_TZ=Asia/Tokyo を効かせること（cronの実装によっては非対応。その場合は
# UTCへ換算して書く）。
CRON_TZ=Asia/Tokyo
SHELL=/bin/bash

# 会議の開催（カレンダー上の予定名 / JST）
#   取締役mtg            月曜 10:00-11:00（週次）
#   経営レイヤー定例mtg   月曜 15:00-16:00（2026-08-24の回で隔週→週次に変更）

# --- A-1 取締役週次定例：次回分の準備 -------------------------------------
# 毎週金曜09:00。月曜開催の回に対して、金曜の朝にページを作ってSlackで依頼する。
0 9 * * 5   cd /path/to/meeting-automation && ./run.sh board-weekly-prep

# --- B-1 取締役週次定例：会議後の議事録生成 -------------------------------
# 会議終了の1時間後。
0 12 * * 1  cd /path/to/meeting-automation && ./run.sh board-weekly-minutes today
# リトライ。文字起こしの生成が遅れて上が空振りした回を拾う。前日分を対象にする
# ので毎朝動かして構わない。該当する予定がない日は何も書かずに終了する。
0 8 * * *   cd /path/to/meeting-automation && ./run.sh board-weekly-minutes yesterday

# --- A-2 ＋ C 経営レイヤー定例：次回分の準備と取締役提案の転記 ------------
# 開催2営業日前09:00。月曜開催なので木曜。
0 9 * * 4   cd /path/to/meeting-automation && ./run.sh exec-layer-prep

# --- B-2 経営レイヤー定例：会議後の議事録生成 -----------------------------
0 17 * * 1  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes today
# リトライ。B-1のリトライと同時に走らせないよう15分ずらしている。
15 8 * * *  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes yesterday
