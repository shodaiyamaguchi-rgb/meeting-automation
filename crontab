# 会議議事録の自動化 / crontab
#
#   crontab crontab        で登録、crontab -l で確認
#
# /path/to/meeting-automation は実際の配置に置き換えること。
#
# 時刻はサーバのローカルタイムゾーンで解釈される。JST以外のサーバに置く場合は
# CRON_TZ=Asia/Tokyo を効かせること（cronの実装によっては非対応。その場合は
# UTCへ換算して書く）。
CRON_TZ=Asia/Tokyo
SHELL=/bin/bash

# 会議の開催（カレンダー上の予定名 / JST）
#   取締役mtg            月曜 10:00-11:00（週次）
#   経営レイヤー定例mtg   月曜 15:00-16:00（2026-08-24の回で隔週→週次に変更）

# --- A-1 取締役週次定例：次回分の準備 -------------------------------------
# 毎週金曜12:00。月曜開催の回に対して、金曜のうちにページを作ってSlackで依頼する。
0 12 * * 5  cd /path/to/meeting-automation && ./run.sh board-weekly-prep

# --- B-1 取締役週次定例：会議後の議事録生成 -------------------------------
# 火曜12:00。前日（月曜）の回を処理する。B-1 のリトライ枠は置かない。
0 12 * * 2  cd /path/to/meeting-automation && ./run.sh board-weekly-minutes yesterday

# --- A-2 ＋ C 経営レイヤー定例：次回分の準備と取締役提案の転記 ------------
# 毎週金曜12:00。A-1 と同じ枠で回す。記入期限が当日午前中までなので、金曜に出して
# おけば週末と月曜午前が記入時間になる。
0 12 * * 5  cd /path/to/meeting-automation && ./run.sh exec-layer-prep

# --- B-2 経営レイヤー定例：会議後の議事録生成 -----------------------------
0 17 * * 1  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes today

# --- D-1 取締役週次定例：執行役員レイヤーへの共有案と承認依頼 --------------
# 火曜13:00。B-1（12:00）が議事録を生成した直後。前日（月曜）の回が対象。案を
# オーナーへDMするだけで、チャンネルへは投稿しない。
0 13 * * 2  cd /path/to/meeting-automation && ./run.sh board-weekly-exec-digest yesterday

# --- D-2 取締役週次定例：承認を確認して投稿 --------------------------------
# 火曜18:00。前日（月曜）の回が対象。承認が返っていれば本体を投稿し、続けてスレッドへ議論の内容を投稿する。
# 返っていなければ何もしない。承認の期限は17:30（D-1のDMにそう書いてある）。
0 18 * * 2  cd /path/to/meeting-automation && ./run.sh board-weekly-exec-digest-post yesterday

# --- リトライ（B-2 のみ） --------------------------------------------------
# 火曜12:15。文字起こしの生成が遅れて月曜のB-2が空振りした場合に、前日分を拾う。
# 既にステータスが進んでいれば二重実行を避けて終了する。B-1 は火曜12:00が本番なのでリトライ枠なし。
15 12 * * 2 cd /path/to/meeting-automation && ./run.sh exec-layer-minutes yesterday

# D-1 / D-2 にリトライ枠は置かない。D-2 は実行日（対象日の翌日）を過ぎると投稿しないため、
# 翌日に走らせても必ず空振りする。火曜17:30までに承認が間に合わなかった回は、
# その週は共有を見送る。どうしても出す場合は手で
#   ./run.sh board-weekly-exec-digest-post <対象日>
# を回し、本文の日付表記を確認したうえで投稿すること。
