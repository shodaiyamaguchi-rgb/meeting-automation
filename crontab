# 会議議事録の自動化 / crontab
#
#   crontab crontab        で登録、crontab -l で確認
#
# /path/to/meeting-automation は実際の配置に置き換えること。
#
# 時刻はサーバのローカルタイムゾーンで解釈される。JST以外のサーバに置く場合は
# CRON_TZ=Asia/Tokyo を効かせること（cronの実装によっては非対応。その場合は
# UTCへ換算して書く）。
CRON_TZ=Asia/Tokyo
SHELL=/bin/bash

# 会議の開催（カレンダー上の予定名 / JST）
#   取締役週次定例        木曜 11:00-12:00（週次。2026-11-05の回から。それ以前は月曜 10:00）
#   経営レイヤー定例mtg   月曜 15:00-16:00（週次）

# --- A-1 取締役週次定例：次回分の準備 -------------------------------------
# 毎週月曜12:00。その週の木曜開催の回に対して、ページを作ってSlackで依頼する。
# 記入期間は月曜〜水曜（開催前日まで）。
0 12 * * 1  cd /path/to/meeting-automation && ./run.sh board-weekly-prep

# --- B-1 取締役週次定例：会議後の議事録生成 -------------------------------
# 会議終了（12:00）の1時間後。
0 13 * * 4  cd /path/to/meeting-automation && ./run.sh board-weekly-minutes today

# --- A-2 ＋ C 経営レイヤー定例：次回分の準備と取締役提案の転記 ------------
# 毎週金曜12:00。木曜の取締役週次定例（B-1 済み）の 🟦「執行役員連携事項」を、
# 月曜の経営レイヤー定例のアジェンダ4へ転記する。木曜より前には動かさない。
0 12 * * 5  cd /path/to/meeting-automation && ./run.sh exec-layer-prep

# --- B-2 経営レイヤー定例：会議後の議事録生成 -----------------------------
0 17 * * 1  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes today

# --- リトライ ---------------------------------------------------------------
# 文字起こしの生成が遅れて空振りした場合に、前日分を拾う。既にステータスが進んで
# いれば二重実行を避けて終了する。該当する会議がない日は何もしない。
#   金曜12:00 … 木曜の取締役週次定例
#   火曜12:00 … 月曜の経営レイヤー定例
0 12 * * 5  cd /path/to/meeting-automation && ./run.sh board-weekly-minutes yesterday
0 12 * * 2  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes yesterday

# --- D-1 / D-2（執行役員レイヤーへの当日共有）は停止中 --------------------
# 2026-11-04 停止。取締役週次定例が木曜になり、金曜の処理Cが月曜のアジェンダ4へ
# 転記するため役割が重なる。再開する場合は、プロンプトの時刻前提を直してから戻す。
# 0 13 * * 1  cd /path/to/meeting-automation && ./run.sh board-weekly-exec-digest today
# 0 18 * * 1  cd /path/to/meeting-automation && ./run.sh board-weekly-exec-digest-post today
