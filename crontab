# 会議議事録の自動化 / crontab
#
#   crontab crontab        で登録、crontab -l で確認
#
# /path/to/meeting-automation は実際の配置に置き換えること。
#
# 時刻はサーバのローカルタイムゾーンで解釈される。JST以外のサーバに置く場合は
# CRON_TZ=Asia/Tokyo を効かせること（cronの実装によっては非対応。その場合は
# UTCへ換算して書く）。
CRON_TZ=Asia/Tokyo
SHELL=/bin/bash

# 会議の開催（カレンダー上の予定名 / JST）
#   取締役mtg            月曜 10:00-11:00（週次）
#   経営レイヤー定例mtg   月曜 15:00-16:00（2026-08-24の回で隔週→週次に変更）

# --- A-1 取締役週次定例：次回分の準備 -------------------------------------
# 毎週金曜12:00。月曜開催の回に対して、金曜のうちにページを作ってSlackで依頼する。
0 12 * * 5  cd /path/to/meeting-automation && ./run.sh board-weekly-prep

# --- B-1 取締役週次定例：会議後の議事録生成 -------------------------------
# 会議終了の1時間後。
0 12 * * 1  cd /path/to/meeting-automation && ./run.sh board-weekly-minutes today
# リトライは火曜08:00にまとめてある（下部を参照）。

# --- A-2 ＋ C 経営レイヤー定例：次回分の準備と取締役提案の転記 ------------
# 毎週金曜12:00。A-1 と同じ枠で回す。記入期限が当日午前中までなので、金曜に出して
# おけば週末と月曜午前が記入時間になる。
0 12 * * 5  cd /path/to/meeting-automation && ./run.sh exec-layer-prep

# --- B-2 経営レイヤー定例：会議後の議事録生成 -----------------------------
0 17 * * 1  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes today

# --- リトライ（両会議まとめて） -------------------------------------------
# 火曜08:00。文字起こしの生成が遅れて月曜の2本が空振りした場合に、前日分を拾う。
# 既にステータスが進んでいれば二重実行を避けて終了する。
0 8 * * 2   cd /path/to/meeting-automation && ./run.sh board-weekly-minutes yesterday
15 8 * * 2  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes yesterday
