# 会議議事録の自動化 / crontab
#
#   crontab crontab        で登録、crontab -l で確認
#
# 時刻はサーバのローカルタイムゾーンで解釈される。JST以外のサーバに置く場合は
# CRON_TZ=Asia/Tokyo を効かせること（cronの実装によっては非対応。その場合は
# UTCへ換算して書く）。
CRON_TZ=Asia/Tokyo
SHELL=/bin/bash

# --- B-1 取締役週次定例：会議後の議事録生成 -------------------------------
#
# 1本目：会議終了の1時間後。カレンダー上の「取締役mtg」は月曜 10:00-11:00 JST
# なので 12:00 に実行する。パスを実際の配置に置き換えてから有効にすること。
#
0 12 * * 1  cd /path/to/meeting-automation && ./run.sh board-weekly-minutes today
#
# 2本目（リトライ）。文字起こしの生成が遅れて1本目が空振りした回を拾う。
# 前日分を対象にするので毎朝動かして構わない。該当する予定がない日は、
# 何も書かずに報告だけして終了する。
0 8 * * *  cd /path/to/meeting-automation && ./run.sh board-weekly-minutes yesterday

# --- 以降は未実装 ----------------------------------------------------------
# A-1 board-weekly-prep   毎週金曜 09:00
#   0 9 * * 5   cd /path/to/meeting-automation && ./run.sh board-weekly-prep
#
# A-2 exec-layer-prep     開催2営業日前 09:00。経営レイヤー定例は 2026-08-24 の回で
#   隔週→週次（月曜 15:00）に変更されたため、2営業日前は木曜になる。
#   0 9 * * 4   cd /path/to/meeting-automation && ./run.sh exec-layer-prep
#
# B-2 exec-layer-minutes  会議終了の1時間後（月曜 17:00）＋ 翌朝08:00のリトライ
#   0 17 * * 1  cd /path/to/meeting-automation && ./run.sh exec-layer-minutes today
#   0 8 * * *   cd /path/to/meeting-automation && ./run.sh exec-layer-minutes yesterday
